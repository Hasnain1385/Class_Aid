APP_NAME="Class Aid"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_INSTALLED=false

# Dual Database Support: 'sqlite' or 'mysql'
DB_CONNECTION=sqlite

# SQLite settings (relative to project root)
DB_DATABASE=database/database.sqlite

# MySQL settings (used when DB_CONNECTION=mysql, supports non-root users)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=class_aid
DB_USER=root
DB_PASSWORD=

# Outgoing Mail (SMTP) Settings
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=billing@classaid.com
MAIL_FROM_NAME="Class Aid Suite"

# In-Place Update & GitHub Repository
GITHUB_REPO=Hasnain1385/Class_Aid
GITHUB_BRANCH=main
GITHUB_TOKEN=

# Performance & Low-RAM Optimization
MEMORY_LIMIT=128M
