APP_NAME="Class Aid"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_INSTALLED=false

# Dual Database Support: 'sqlite' or 'mysql'
DB_CONNECTION=sqlite

# SQLite settings (relative to project root)
DB_DATABASE=database/database.sqlite

# MySQL settings (used when DB_CONNECTION=mysql, supports non-root users)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=class_aid
DB_USER=root
DB_PASSWORD=
