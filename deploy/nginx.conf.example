# Class Aid - Production Nginx Configuration Example
# Place in /etc/nginx/sites-available/class_aid and symlink to /etc/nginx/sites-enabled/

server {
    listen 80;
    listen [::]:80;
    server_name classaid.yourdomain.com; # Replace with your actual domain or VPS IP

    # Redirect HTTP to HTTPS (uncomment when SSL certificate is installed)
    # return 301 https://$host$request_uri;

    root /var/www/class_aid/public;
    index index.php index.html;

    charset utf-8;
    client_max_body_size 25M;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Main Application Routing
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Static Assets Caching
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
        access_log off;
    }

    # Pass PHP scripts to FastCGI server
    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock; # Adjust if using php8.3-fpm
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
        fastcgi_read_timeout 180s;
    }

    # Deny access to hidden files and sensitive directories
    location ~ /\.(?!well-known).* {
        deny all;
    }

    location ~ ^/(\.env|composer\.(json|lock)|database|storage|src|tests|deploy|bin|vendor) {
        deny all;
        return 404;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    # Logging
    access_log /var/log/nginx/class_aid_access.log;
    error_log  /var/log/nginx/class_aid_error.log error;
}
